{
  "name": "tldr-shield",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "eval": "tsx eval/runEval.ts",
    "eval:holdout": "tsx eval/runEval.ts --dataset=eval/dataset_holdout.jsonl",
    "eval:quick": "tsx eval/runEval.ts --tier=quick",
    "eval:deep": "tsx eval/runEval.ts --tier=deep",
    "eval:dark": "tsx eval/runEval.ts --dark",
    "eval:basic20": "tsx eval/runEval.ts --dataset=eval/dataset_basic.jsonl",
    "eval:basic20:quick": "tsx eval/runEval.ts --dataset=eval/dataset_basic.jsonl --tier=quick",
    "eval:basic20:deep": "tsx eval/runEval.ts --dataset=eval/dataset_basic.jsonl --tier=deep",
    "eval:deep20": "tsx eval/runEval.ts --dataset=eval/dataset_deep.jsonl",
    "eval:deep20:quick": "tsx eval/runEval.ts --dataset=eval/dataset_deep.jsonl --tier=quick",
    "eval:deep20:deep": "tsx eval/runEval.ts --dataset=eval/dataset_deep.jsonl --tier=deep",
    "eval:stability": "tsx eval/stability.ts",
    "bench:gemini": "tsx eval/benchmarkGemini.ts",
    "bench:gemini:smoke": "tsx eval/benchmarkGemini.ts --smoke",
    "bench:gemini:list": "tsx eval/benchmarkGemini.ts --list",
    "bench:gemini:basic20": "tsx eval/benchmarkGemini.ts --dataset=eval/dataset_basic.jsonl",
    "bench:gemini:deep20": "tsx eval/benchmarkGemini.ts --dataset=eval/dataset_deep.jsonl",
    "check:nim": "tsx eval/checkNimKeys.ts",
    "check:nim:health": "npx tsx eval/nimHealthMonitor.ts",
    "check:gemini": "tsx eval/checkGeminiKeys.ts",
    "predeploy": "npm run lint && npm run build",
    "deploy": "gcloud run deploy tldr-shield --source . --region us-central1 --project gen-lang-client-0199678316 --allow-unauthenticated",
    "deploy:rules": "firebase deploy --only firestore:rules --project gen-lang-client-0199678316",
    "recheck": "curl -X POST https://tldr-shield-292798741977.us-central1.run.app/api/recheck -H \"Content-Type: application/json\" -H \"x-internal-key: %INTERNAL_API_KEY%\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@sentry/node": "^10.49.0",
    "@types/cors": "^2.8.19",
    "@upstash/redis": "^1.37.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compromise": "^14.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "jsdom": "^29.0.1",
    "lucide-react": "^0.546.0",
    "mark.js": "^8.11.1",
    "motion": "^12.23.24",
    "openai": "^6.32.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.5"
  }
}
