# ── Gemini API Key Pools ──────────────────────────────────────────────────────
# SCAN_KEYS: Dedicated to core analysis. Tried in order (Primary -> Fallback).
# 10 RPM per free key. Add more keys to increase total throughput.
GEMINI_SCAN_KEY_1=your-key-here
GEMINI_SCAN_KEY_2=
GEMINI_SCAN_KEY_3=

# UTILITY_KEYS: Dedicated to citations, embeddings, and GDPR generation.
# Keeps utility tasks from stealing scan key capacity.
GEMINI_UTIL_KEY_1=your-key-here
GEMINI_UTIL_KEY_2=
GEMINI_UTIL_KEY_3=

# ── Gemini Model Strategy ─────────────────────────────────────────────────────
GEMINI_MODEL_SCAN_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_SCAN_FALLBACK=gemini-3-flash-preview
GEMINI_MODEL_UTILITY=gemini-2.5-flash

# ── Dynamic Pro Mode (Demo Only) ──────────────────────────────────────────────
# When enabled via Admin Console (Shift+A), deep scans use the paid PRO key.
GEMINI_PRO_MODE=false
GEMINI_PRO_KEY=your-paid-key-here
GEMINI_PRO_MODEL=gemini-2.5-pro

# Legacy env vars still accepted for backwards compatibility:
#   GEMINI_API_KEY, GEMINI_API_KEY_2..5 (single keys)
#   GEMINI_MODEL                        (legacy alias for GEMINI_MODEL_PRIMARY)

# Firebase Admin credentials — use ONE of these:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # inline JSON (PaaS)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json    # file path (local dev)

# Optional tuning
APP_URL=https://your-cloud-run-url.run.app
INTERNAL_API_KEY=your-internal-api-key

# Monitoring (optional but recommended)
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX   # get free DSN at sentry.io
