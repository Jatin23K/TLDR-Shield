# ==============================================================================
# 🤖 AI ENGINE SETTINGS (GEMINI)
# ==============================================================================
# PRIMARY: Tried first for all scans.
# FALLBACK: Used automatically when PRIMARY hits rate limits.
# PRO: The high-accuracy model (only used if GEMINI_PRO_MODE=true).
GEMINI_MODEL_SCAN_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_SCAN_FALLBACK=gemini-2.5-flash-lite
GEMINI_MODEL_UTILITY=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-2.5-pro

# ─── Pro Mode Master Controls ───
# Master Switch: If false, Pro model is disabled globally.
GEMINI_PRO_MODE=true
# User Access: If true, public users get Pro. If false, only Admins do.
GEMINI_PRO_FOR_USERS=false


# ==============================================================================
# 🔑 API KEY POOLS
# ==============================================================================
# SCAN POOL: Dedicated to core analysis.
GEMINI_SCAN_KEY_1="your-key-here"
GEMINI_SCAN_KEY_2="your-key-here"
GEMINI_SCAN_KEY_3="your-key-here"

# UTILITY POOL: Grounding, GDPR emails, and health checks.
GEMINI_UTIL_KEY_1="your-key-here"
GEMINI_UTIL_KEY_2="your-key-here"
GEMINI_UTIL_KEY_3="your-key-here"

# PAID/PRO KEY: Used for deep reasoning passes.
GEMINI_PRO_KEY="your-paid-pro-key-here"


# ==============================================================================
# ⚡ L1 CACHE (UPSTASH REDIS)
# ==============================================================================
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-rest-token-here"


# ==============================================================================
# 🔥 L2 CACHE & AUTH (FIREBASE)
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Note: In production, provide the full JSON string in FIREBASE_SERVICE_ACCOUNT_JSON


# ==============================================================================
# 🛠️ ADMIN & IDENTITY
# ==============================================================================
# Internal API Key: Used for maintenance curl commands. Generate a long random string.
INTERNAL_API_KEY="your-internal-key-here"
# Admin Email: The designation user account that can bypass credits.
ADMIN_EMAIL="admin@example.com"


# ==============================================================================
# 🌐 SYSTEM URLS
# ==============================================================================
APP_URL="https://your-app-url.run.app"
VITE_API_URL="https://your-api-url.run.app"
