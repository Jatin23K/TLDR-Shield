# NVIDIA NIM API keys (required)
NIM_API_KEY_1="nvapi-REPLACE_ME_PRIMARY"
NIM_API_KEY_2="nvapi-REPLACE_ME_SECONDARY"
NIM_API_KEY_3="nvapi-REPLACE_ME_TERTIARY"

# Optional model overrides
NIM_MODEL_QUICK="meta/llama-3.3-70b-instruct"
NIM_MODEL_DEEP="meta/llama-3.3-70b-instruct"
NIM_PER_KEY_TIMEOUT_MS="12000"
NIM_RETRY_ROUNDS="3"
NIM_RETRY_BASE_BACKOFF_MS="1200"

# Backend/API settings
APP_URL="https://your-app-url.example"
INTERNAL_API_KEY=""

# Firebase Admin credentials (local dev only)
FIREBASE_SERVICE_ACCOUNT_PATH="C:/path/to/service-account.json"

# Dev-only: allow scans when Firestore credit service is unavailable
ALLOW_UNMETERED_LOCAL="false"
